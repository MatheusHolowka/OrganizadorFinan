# Banco de Dados MySQL
DB_ROOT_PASSWORD=root_secret_pass
DB_NAME=organizador_db
DB_USER=organizador_user
DB_PASSWORD=organizador_pass
DB_PORT=3306

# API Back-end (NestJS)
API_PORT=3000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_development_change_in_production
JWT_EXPIRATION=7d

# Front-end (Angular SSR)
APP_PORT=4200
FRONTEND_URL=http://localhost:4200
API_INTERNAL_URL=http://api:3000

# E-mail & Resend Mailer
RESEND_API_KEY=your_resend_api_key_here
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your_resend_api_key_here
SMTP_FROM=FinanOrganizador <noreply@organizadorfinan.com.br>

# Pluggy Open Finance
PLUGGY_CLIENT_ID=your_pluggy_client_id_here
PLUGGY_CLIENT_SECRET=your_pluggy_client_secret_here
