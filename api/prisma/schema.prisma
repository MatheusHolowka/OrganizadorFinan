// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum AccountType {
  CHECKING
  SAVINGS
  INVESTMENT
  CASH
  DIGITAL_WALLET
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum CardBrand {
  VISA
  MASTERCARD
  ELO
  AMEX
  HIPERCARD
  OTHER
}

enum InvoiceStatus {
  OPEN
  CLOSED
  PAID
  OVERDUE
}

enum VaultCategory {
  VEHICLE
  EMERGENCY_FUND
  TRAVEL
  REAL_ESTATE
  INVESTMENT
  EDUCATION
  RETIREMENT
  ELECTRONICS
  OTHER
}

enum VaultStatus {
  IN_PROGRESS
  COMPLETED
  PAUSED
}

enum VaultMovementType {
  DEPOSIT
  WITHDRAWAL
}

enum ImportFormat {
  OFX
  CSV
}

enum ImportStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum FamilyRole {
  OWNER
  ADMIN
  MEMBER
}

enum FamilyMemberStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// ------------------------------------------------------
// CORE MODELS: USER & ACCOUNTS
// ------------------------------------------------------

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  passwordHash         String    @map("password_hash")
  name                 String
  avatarUrl            String?   @map("avatar_url")
  currency             String    @default("BRL")
  failedLoginAttempts     Int       @default(0) @map("failed_login_attempts")
  isLocked                Boolean   @default(false) @map("is_locked")
  resetPasswordToken      String?   @map("reset_password_token")
  resetPasswordExpires    DateTime? @map("reset_password_expires")
  isEmailVerified         Boolean   @default(false) @map("is_email_verified")
  emailVerificationToken  String?   @map("email_verification_token")
  emailVerificationExpires DateTime? @map("email_verification_expires")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  accounts            Account[]
  categories          Category[]
  transactions        Transaction[]
  creditCards         CreditCard[]
  vaults              Vault[]
  importBatches       ImportBatch[]
  createdFamilyGroups FamilyGroup[]  @relation("FamilyGroupCreator")
  familyMemberships   FamilyMember[]

  @@map("users")
}

model Account {
  id             String      @id @default(uuid())
  userId         String      @map("user_id")
  name           String
  type           AccountType @default(CHECKING)
  initialBalance Decimal     @default(0.00) @map("initial_balance") @db.Decimal(12, 2)
  currentBalance Decimal     @default(0.00) @map("current_balance") @db.Decimal(12, 2)
  color          String?     @default("#10B981")
  icon           String?     @default("wallet")
  isArchived     Boolean     @default(false) @map("is_archived")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]      @relation("AccountTransactions")
  transfersReceived Transaction[]      @relation("TransferDestinationAccount")
  creditCards       CreditCard[]       @relation("CardPaymentAccount")
  vaultTransactions VaultTransaction[]
  importBatches     ImportBatch[]

  @@index([userId])
  @@map("accounts")
}

// ------------------------------------------------------
// CATEGORIES & TRANSACTIONS
// ------------------------------------------------------

model Category {
  id        String       @id @default(uuid())
  userId    String?      @map("user_id")
  name      String
  type      CategoryType
  color     String?      @default("#64748B")
  icon      String?      @default("tag")
  parentId  String?      @map("parent_id")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user                   User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent                 Category?               @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children               Category[]              @relation("CategoryHierarchy")
  transactions           Transaction[]
  creditCardTransactions CreditCardTransaction[]

  @@index([userId])
  @@index([parentId])
  @@map("categories")
}

model Transaction {
  id                   String            @id @default(uuid())
  userId               String            @map("user_id")
  accountId            String            @map("account_id")
  categoryId           String?           @map("category_id")
  destinationAccountId String?           @map("destination_account_id")
  type                 TransactionType
  status               TransactionStatus @default(COMPLETED)
  amount               Decimal           @db.Decimal(12, 2)
  description          String
  notes                String?           @db.Text
  date                 DateTime          @db.Date
  paymentDate          DateTime?         @map("payment_date")
  isReconciled         Boolean           @default(false) @map("is_reconciled")
  importItemId         String?           @unique @map("import_item_id")
  vaultTransactionId   String?           @unique @map("vault_transaction_id")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  account            Account           @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)
  destinationAccount Account?          @relation("TransferDestinationAccount", fields: [destinationAccountId], references: [id], onDelete: SetNull)
  category           Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  importItem         ImportItem?       @relation(fields: [importItemId], references: [id], onDelete: SetNull)
  vaultTransaction   VaultTransaction? @relation("VaultLinkedTransaction", fields: [vaultTransactionId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([accountId, date])
  @@index([categoryId])
  @@map("transactions")
}

// ------------------------------------------------------
// CREDIT CARDS, INVOICES & INSTALLMENTS
// ------------------------------------------------------

model CreditCard {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  paymentAccountId String?   @map("payment_account_id")
  name             String
  brand            CardBrand @default(MASTERCARD)
  limit            Decimal   @db.Decimal(12, 2)
  closingDay       Int       @map("closing_day")
  dueDay           Int       @map("due_day")
  color            String?   @default("#6366F1")
  lastDigits       String?   @map("last_digits") @db.VarChar(4)
  isArchived       Boolean   @default(false) @map("is_archived")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentAccount Account?                @relation("CardPaymentAccount", fields: [paymentAccountId], references: [id], onDelete: SetNull)
  invoices       CreditCardInvoice[]
  transactions   CreditCardTransaction[]

  @@index([userId])
  @@map("credit_cards")
}

model CreditCardInvoice {
  id                   String        @id @default(uuid())
  creditCardId         String        @map("credit_card_id")
  referenceMonth       Int           @map("reference_month")
  referenceYear        Int           @map("reference_year")
  closingDate          DateTime      @map("closing_date") @db.Date
  dueDate              DateTime      @map("due_date") @db.Date
  totalAmount          Decimal       @default(0.00) @map("total_amount") @db.Decimal(12, 2)
  paidAmount           Decimal       @default(0.00) @map("paid_amount") @db.Decimal(12, 2)
  status               InvoiceStatus @default(OPEN)
  paymentDate          DateTime?     @map("payment_date")
  paymentTransactionId String?       @map("payment_transaction_id")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  creditCard   CreditCard              @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  transactions CreditCardTransaction[]

  @@unique([creditCardId, referenceMonth, referenceYear])
  @@index([creditCardId, status])
  @@map("credit_card_invoices")
}

model CreditCardTransaction {
  id                 String   @id @default(uuid())
  creditCardId       String   @map("credit_card_id")
  invoiceId          String   @map("invoice_id")
  categoryId         String?  @map("category_id")
  description        String
  totalAmount        Decimal  @map("total_amount") @db.Decimal(12, 2)
  installmentAmount  Decimal  @map("installment_amount") @db.Decimal(12, 2)
  installmentNumber  Int      @default(1) @map("installment_number")
  totalInstallments  Int      @default(1) @map("total_installments")
  installmentGroupId String?  @map("installment_group_id")
  purchaseDate       DateTime @map("purchase_date")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  creditCard CreditCard        @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  invoice    CreditCardInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  category   Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([creditCardId, purchaseDate])
  @@index([installmentGroupId])
  @@map("credit_card_transactions")
}

// ------------------------------------------------------
// VAULTS & GOALS (SISTEMA DE COFRES COM ISOLAMENTO)
// ------------------------------------------------------

model Vault {
  id                       String        @id @default(uuid())
  userId                   String        @map("user_id")
  title                    String
  description              String?       @db.Text
  targetAmount             Decimal       @map("target_amount") @db.Decimal(12, 2)
  currentAmount            Decimal       @default(0.00) @map("current_amount") @db.Decimal(12, 2)
  deadline                 DateTime?     @db.Date
  category                 VaultCategory @default(OTHER)
  icon                     String?       @default("piggy-bank")
  color                    String?       @default("#8B5CF6")
  status                   VaultStatus   @default(IN_PROGRESS)
  isolatedFromDailyBalance Boolean       @default(true) @map("isolated_from_daily_balance")
  createdAt                DateTime      @default(now()) @map("created_at")
  updatedAt                DateTime      @updatedAt @map("updated_at")

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions VaultTransaction[]

  @@index([userId])
  @@map("vaults")
}

model VaultTransaction {
  id          String            @id @default(uuid())
  vaultId     String            @map("vault_id")
  accountId   String?           @map("account_id")
  type        VaultMovementType
  amount      Decimal           @db.Decimal(12, 2)
  description String?
  date        DateTime          @default(now())
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  vault                Vault        @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  account              Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  financialTransaction Transaction? @relation("VaultLinkedTransaction")

  @@index([vaultId])
  @@index([accountId])
  @@map("vault_transactions")
}

// ------------------------------------------------------
// IMPORT ENGINE (OFX / CSV)
// ------------------------------------------------------

model ImportBatch {
  id            String       @id @default(uuid())
  userId        String       @map("user_id")
  accountId     String       @map("account_id")
  filename      String
  format        ImportFormat
  fileChecksum  String       @map("file_checksum")
  status        ImportStatus @default(PROCESSING)
  totalItems    Int          @default(0) @map("total_items")
  importedItems Int          @default(0) @map("imported_items")
  skippedItems  Int          @default(0) @map("skipped_items")
  errorMessage  String?      @map("error_message") @db.Text
  importedAt    DateTime     @default(now()) @map("imported_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  items   ImportItem[]

  @@index([userId, accountId])
  @@index([fileChecksum])
  @@map("import_batches")
}

model ImportItem {
  id                   String       @id @default(uuid())
  batchId              String       @map("batch_id")
  externalId           String?      @map("external_id")
  date                 DateTime     @db.Date
  amount               Decimal      @db.Decimal(12, 2)
  description          String
  memo                 String?
  rawType              String?      @map("raw_type")
  isDuplicate          Boolean      @default(false) @map("is_duplicate")
  matchedTransactionId String?      @map("matched_transaction_id")
  createdAt            DateTime     @default(now()) @map("created_at")

  batch       ImportBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  transaction Transaction?

  @@index([batchId])
  @@index([externalId])
  @@map("import_items")
}

// ------------------------------------------------------
// FAMILY & MULTI-USER SHARING
// ------------------------------------------------------

model FamilyGroup {
  id          String   @id @default(uuid())
  name        String   // Ex: "Família Silva"
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  creator User           @relation("FamilyGroupCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members FamilyMember[]

  @@index([createdById])
  @@map("family_groups")
}

model FamilyMember {
  id            String             @id @default(uuid())
  familyGroupId String             @map("family_group_id")
  userId        String?            @map("user_id")
  email         String
  role          FamilyRole         @default(MEMBER)
  status        FamilyMemberStatus @default(PENDING)
  invitedAt     DateTime           @default(now()) @map("invited_at")
  joinedAt      DateTime?          @map("joined_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  familyGroup FamilyGroup @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([familyGroupId, email])
  @@index([familyGroupId])
  @@index([userId])
  @@index([email])
  @@map("family_members")
}
